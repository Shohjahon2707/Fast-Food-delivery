digraph use_cases {
 graph [rankdir=LR,bgcolor="white",pad="0.4"];
 node [fontname="DejaVu Sans",fontsize=12,style=filled,fillcolor="#f0eafa",color="#7048eb"];
 edge [color="#9990aa"];
 guest [shape=box,label="Гость"];
 buyer [shape=box,label="Покупатель"];
 staff [shape=box,label="Внутренний сотрудник"];
 catalog [label="Рестораны и меню"];
 smart [label="Умный обед\nКатегория + цена"];
 login [label="Регистрация / вход"];
 cart [label="Своя корзина"];
 order [label="Адрес / оформить заказ"];
 history [label="История / статус / отмена"];
 process [label="Обработка заказа"];
 guest -> {catalog smart login};
 buyer -> {catalog smart cart order history};
 staff -> process;
}